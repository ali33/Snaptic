<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Snaptic.App.Views.AboutWindow"
        Title="Snaptic — Giới thiệu"
        Width="720" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        CanResize="False">
  <Grid ColumnDefinitions="*,Auto" Margin="24">

    <StackPanel Grid.Column="0" Spacing="14" Margin="0,0,24,0" VerticalAlignment="Center">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Image Name="AppIcon" Width="40" Height="40" VerticalAlignment="Center" />
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Snaptic" FontSize="22" FontWeight="Bold" />
          <TextBlock Name="VersionText" Foreground="#6B7280" FontSize="12" />
        </StackPanel>
      </StackPanel>

      <Border Background="#1A3B82F6" BorderBrush="#403B82F6" BorderThickness="1"
              CornerRadius="6" Padding="14,12">
        <TextBlock Name="DedicationText" TextWrapping="Wrap" LineHeight="21" />
      </Border>

      <TextBlock Name="PurposeText" TextWrapping="Wrap" LineHeight="21" Foreground="#9CA3AF" />

      <TextBlock Name="DonateText" TextWrapping="Wrap" Margin="0,6,0,0" FontWeight="SemiBold" />

      <StackPanel Spacing="3">
        <TextBlock Name="BankText" Foreground="#9CA3AF" FontSize="13" />
        <TextBlock Name="HolderText" FontSize="13" />
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Name="AccountText" FontSize="15" FontWeight="Bold"
                     FontFamily="Consolas,Courier New,monospace" VerticalAlignment="Center" />
          <Button Name="CopyAccountButton" Content="Copy số TK" Padding="8,3" FontSize="12" />
        </StackPanel>
      </StackPanel>

      <Separator Margin="0,4" />

      <StackPanel Spacing="2">
        <TextBlock Name="CopyrightText" Foreground="#9CA3AF" FontSize="12" />
        <TextBlock Name="LicenseText" Foreground="#9CA3AF" FontSize="12" TextWrapping="Wrap" />
      </StackPanel>

      <!-- Thu gọn được: bắt đọc tường chữ pháp lý mỗi lần mở Giới thiệu là phản tác
           dụng — người ta sẽ bỏ qua luôn cả phần đáng đọc. Nhưng vẫn phải có mặt,
           vì GPL mục 15-16 đòi chương trình tự thông báo. -->
      <Expander Name="LegalExpander" Header="Miễn trừ trách nhiệm và giới hạn đã biết">
        <StackPanel Spacing="8" Margin="0,6,0,0">
          <TextBlock Name="DisclaimerText" TextWrapping="Wrap" FontSize="12"
                     Foreground="#D1D5DB" LineHeight="18" />
          <TextBlock Name="LimitsText" TextWrapping="Wrap" FontSize="12"
                     Foreground="#FBBF24" LineHeight="18" />
          <TextBlock Name="LegalNoteText" TextWrapping="Wrap" FontSize="11"
                     Foreground="#6B7280" FontStyle="Italic" />
        </StackPanel>
      </Expander>

      <Button Name="CloseButton" Content="Đóng" HorizontalAlignment="Left" Margin="0,8,0,0" />
    </StackPanel>

    <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="6"
            VerticalAlignment="Center">
      <Image Name="DonateQr" Width="270" Stretch="Uniform" />
    </Border>
  </Grid>
</Window>
